// A list of values of one type that grows on the heap.
//
// A Vec owns its elements: assigning or passing it moves it, and `copy`
// makes a second one. `v[i]` reads or writes an element and panics past
// the end; `for x in v` walks the elements and `for i, x in v` their
// indexes too.
//
// # Examples
//
// ```zeru
// var v: Vec<i32> = Vec[3, 1, 2];
// v.push(5);
// v[0] = 4;
// for i, x in v {
//     print("{}:{} ", i, x);
// }
// println(""); // 0:4 1:1 2:2 3:5
// ```
pub struct Vec<T> {
    // Returns an empty Vec.
    //
    // It allocates nothing until the first push. A list literal makes one
    // with elements: `var v: Vec<i32> = Vec[1, 2, 3];`.
    //
    // # Examples
    //
    // ```zeru
    // var names: Vec<str> = Vec.new();
    // println("{}", names.len()); // 0
    // ```
    fn new() Vec<T> {}

    // Returns an empty Vec with room for `capacity` elements.
    //
    // Pushing up to `capacity` elements then allocates nothing more, which
    // saves time when the final size is known.
    //
    // # Examples
    //
    // ```zeru
    // var squares: Vec<i32> = Vec.with_capacity(10);
    // for i in 0..10 {
    //     squares.push(i * i);
    // }
    // println("{} {}", squares.len(), squares.capacity()); // 10 10
    // ```
    fn with_capacity(capacity: usize) Vec<T> {}

    // Returns the number of elements.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<str> = Vec["a", "b"];
    // println("{}", v.len()); // 2
    // ```
    fn len(self) usize {}

    // Returns how many elements fit before the Vec has to grow.
    //
    // It is never less than the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.with_capacity(8);
    // v.push(1);
    // println("{} {}", v.len(), v.capacity()); // 1 8
    // ```
    fn capacity(self) usize {}

    // Returns whether the Vec has no elements.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.new();
    // println("{}", v.is_empty()); // true
    // v.push(1);
    // println("{}", v.is_empty()); // false
    // ```
    fn is_empty(self) bool {}

    // Adds `value` at the end.
    //
    // When the Vec is full it moves to a buffer twice as big, so pushing
    // takes O(1) time on average.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2];
    // v.push(3);
    // println("{} {}", v.len(), v[2]); // 3 3
    // ```
    fn push(var self, value: T) {}

    // Removes the last element and returns it, or None when the Vec is empty.
    //
    // # Examples
    //
    // ```zeru
    // var stack: Vec<i32> = Vec[1, 2];
    // println("{}", stack.pop().unwrap()); // 2
    // println("{}", stack.pop().unwrap()); // 1
    // println("{}", stack.pop().is_none()); // true
    // ```
    fn pop(var self) T? {}

    // Inserts `value` at `index`, moving the elements after it one place up.
    //
    // Takes O(n) time; `push` adds at the end in O(1). An `index` equal to
    // the length adds at the end.
    //
    // # Panics
    //
    // When `index` is greater than the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 3];
    // v.insert(1, 2);
    // println("{} {} {}", v[0], v[1], v[2]); // 1 2 3
    // ```
    fn insert(var self, index: usize, value: T) {}

    // Removes the element at `index` and returns it, moving the elements
    // after it one place down.
    //
    // Takes O(n) time; `pop` removes the last element in O(1).
    //
    // # Panics
    //
    // When `index` is past the end.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[10, 20, 30];
    // println("{}", v.remove(0)); // 10
    // println("{} {}", v.len(), v[0]); // 2 20
    // ```
    fn remove(var self, index: usize) T {}

    // Returns a reference to the element at `index`, or None past the end.
    //
    // Unlike `v[index]` it does not panic. `*` reads the element through
    // the reference; `.copy()` on the result gives a `T?` holding a copy.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[7, 8];
    // println("{}", *v.get(1).unwrap()); // 8
    // println("{}", v.get(2).is_none()); // true
    // ```
    fn get(self, index: usize) (&T)? {}

    // Removes every element, keeping the memory for new ones.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3];
    // v.clear();
    // println("{} {}", v.is_empty(), v.capacity() >= 3); // true true
    // ```
    fn clear(var self) {}

    // Makes room for at least `additional` more elements, so pushing them
    // allocates nothing more.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1];
    // v.reserve(100);
    // println("{}", v.capacity() >= 101); // true
    // ```
    fn reserve(var self, additional: usize) {}

    // Gives back the memory not in use, so the capacity equals the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.with_capacity(100);
    // v.push(1);
    // v.shrink_to_fit();
    // println("{}", v.capacity()); // 1
    // ```
    fn shrink_to_fit(var self) {}

    // Returns a second Vec holding a copy of every element.
    //
    // Takes O(n) time. Use it when both Vecs must stay usable, since
    // assigning a Vec moves it.
    //
    // # Examples
    //
    // ```zeru
    // var a: Vec<i32> = Vec[1, 2];
    // var b = a.copy();
    // b.push(3);
    // println("{} {}", a.len(), b.len()); // 2 3
    // ```
    fn copy(self) Vec<T> {}

    // Sorts the elements from smallest to largest.
    //
    // For numbers, text and tuples of them, which sort by their first part,
    // then the next. Takes O(n log n) time and no extra memory; equal
    // elements may change order.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[5, -1, 3];
    // v.sort();
    // println("{} {} {}", v[0], v[1], v[2]); // -1 3 5
    // var pairs: Vec<(str, i32)> = Vec[("b", 1), ("a", 2)];
    // pairs.sort();
    // println("{}", pairs); // [("a", 2), ("b", 1)]
    // ```
    fn sort(var self) {}

    // Sorts the elements in the order `order` gives: a negative number when
    // its first element goes before its second.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[3, 1, 2];
    // v.sort_by(fn(a, b) b - a);
    // println("{}", v); // [3, 2, 1]
    // ```
    fn sort_by(var self, order: fn(T, T) i32) {}

    // Exchanges the elements at `i` and `j`.
    //
    // # Panics
    //
    // When `i` or `j` is past the end.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<str> = Vec["a", "b", "c"];
    // v.swap(0, 2);
    // println("{} {}", v[0], v[2]); // c a
    // ```
    fn swap(var self, i: usize, j: usize) {}

    // Puts the elements in the opposite order.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3];
    // v.reverse();
    // println("{}", v); // [3, 2, 1]
    // ```
    fn reverse(var self) {}

    // Moves every element `n` places to the left; those that fall off the
    // start come back at the end.
    //
    // `n` may be any size: it counts in full turns.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4];
    // v.rotate_left(1);
    // println("{}", v); // [2, 3, 4, 1]
    // ```
    fn rotate_left(var self, n: usize) {}

    // Moves every element `n` places to the right; those that fall off the
    // end come back at the start.
    //
    // `n` may be any size: it counts in full turns.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4];
    // v.rotate_right(1);
    // println("{}", v); // [4, 1, 2, 3]
    // ```
    fn rotate_right(var self, n: usize) {}

    // Removes each element equal to the one before it, so every run of
    // equal elements keeps only its first.
    //
    // After `sort()`, it leaves each value once.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 1, 2, 1, 1];
    // v.dedup();
    // println("{}", v); // [1, 2, 1]
    // v.sort();
    // v.dedup();
    // println("{}", v); // [1, 2]
    // ```
    fn dedup(var self) {}

    // Returns views of the elements `n` at a time, the last one shorter when
    // they do not divide evenly. Nothing is copied.
    //
    // # Panics
    //
    // When `n` is 0.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4, 5];
    // println("{}", v.chunks(2)); // [[1, 2], [3, 4], [5]]
    // for group in v.chunks(3) {
    //     print("{} ", group.len());
    // }
    // println(""); // 3 2
    // ```
    fn chunks(self, n: usize) Vec<&[T]> {}

    // Returns a view of every run of `n` elements next to each other, each
    // starting one element after the one before; none when there are fewer
    // than `n`. Nothing is copied.
    //
    // # Panics
    //
    // When `n` is 0.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4];
    // println("{}", v.windows(2)); // [[1, 2], [2, 3], [3, 4]]
    // var rising = 0;
    // for pair in v.windows(2) {
    //     if pair[1] > pair[0] {
    //         rising += 1;
    //     }
    // }
    // println("{}", rising); // 3
    // ```
    fn windows(self, n: usize) Vec<&[T]> {}

    // Returns whether an element equals `value`.
    //
    // Takes O(n) time, looking at each element in turn.
    //
    // # Examples
    //
    // ```zeru
    // var primes: Vec<i32> = Vec[2, 3, 5, 7];
    // println("{} {}", primes.contains(5), primes.contains(4)); // true false
    // ```
    fn contains(self, value: T) bool {}

    // Returns the elements added up, or 0 when there are none.
    //
    // For numbers.
    //
    // # Panics
    //
    // When an integer total does not fit its type.
    //
    // # Examples
    //
    // ```zeru
    // var prices: Vec<f64> = Vec[1.5, 2.25];
    // println("{}", prices.sum()); // 3.75
    // ```
    fn sum(self) T {}

    // Returns the smallest element, or None when there are none.
    //
    // For numbers.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[4, -2, 9];
    // println("{}", v.min().unwrap()); // -2
    // ```
    fn min(self) T? {}

    // Returns the largest element, or None when there are none.
    //
    // For numbers.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[4, -2, 9];
    // println("{}", v.max().unwrap()); // 9
    // ```
    fn max(self) T? {}

    // Returns a new Vec of what `f` returns for each element.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3];
    // println("{}", v.map(fn(x) x * 10)); // [10, 20, 30]
    // ```
    fn map<U>(self, f: fn(T) U) Vec<U> {}

    // Returns a new Vec with a copy of each element `keep` accepts.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4];
    // println("{}", v.filter(fn(x) x % 2 == 0)); // [2, 4]
    // ```
    fn filter(self, keep: fn(T) bool) Vec<T> {}

    // Returns whether `f` accepts some element.
    fn any(self, f: fn(T) bool) bool {}

    // Returns whether `f` accepts every element; true when there are none.
    fn all(self, f: fn(T) bool) bool {}
}

// A view of some elements of an array or a Vec, as `v[1..3]` gives, of
// type `&[T]`. It copies nothing and only reads. `&var v[1..3]` gives one
// that writes them too, of type `&var [T]`, which also has `sort`, `sort_by`,
// `swap`, `reverse`, `rotate_left` and `rotate_right`.
//
// # Examples
//
// ```zeru
// var v: Vec<i32> = Vec[4, 8, 15, 16];
// var middle = v[1..3];
// println("{} {}", middle, middle.sum()); // [8, 15] 23
// var front = &var v[..3];
// front.reverse();
// println("{}", v); // [15, 8, 4, 16]
// ```
struct Slice<T> {
    // Returns the number of elements.
    fn len(self) usize {}

    // Returns whether an element equals `value`.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3];
    // println("{}", v[1..].contains(1)); // false
    // ```
    fn contains(self, value: T) bool {}

    // Returns the elements added up, 0 when there are none.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3];
    // println("{}", v[1..].sum()); // 5
    // ```
    fn sum(self) T {}

    // Returns the smallest element, or None when there are none.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[3, 1, 2];
    // println("{}", v[..1].min().unwrap()); // 3
    // ```
    fn min(self) T? {}

    // Returns the largest element, or None when there are none.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[3, 1, 2];
    // println("{}", v[1..].max().unwrap()); // 2
    // ```
    fn max(self) T? {}

    // Returns a view of every run of `n` elements next to each other.
    //
    // # Panics
    //
    // When `n` is 0.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4];
    // println("{}", v[1..].windows(2)); // [[2, 3], [3, 4]]
    // ```
    fn windows(self, n: usize) Vec<&[T]> {}

    // Returns views of the elements `n` at a time, the last one shorter.
    //
    // # Panics
    //
    // When `n` is 0.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec[1, 2, 3, 4, 5];
    // println("{}", v[..].chunks(2)); // [[1, 2], [3, 4], [5]]
    // ```
    fn chunks(self, n: usize) Vec<&[T]> {}

    // Returns a new Vec of what `f` returns for each element.
    fn map<U>(self, f: fn(T) U) Vec<U> {}

    // Returns a new Vec with a copy of each element `keep` accepts.
    fn filter(self, keep: fn(T) bool) Vec<T> {}

    // Returns whether `f` accepts some element.
    fn any(self, f: fn(T) bool) bool {}

    // Returns whether `f` accepts every element; true when there are none.
    fn all(self, f: fn(T) bool) bool {}

    // Sorts the elements of a `&var [T]` in ascending order.
    fn sort(var self) {}

    // Sorts the elements of a `&var [T]` in the order `order` gives.
    fn sort_by(var self, order: fn(T, T) i32) {}

    // Exchanges the elements of a `&var [T]` at `i` and `j`.
    fn swap(var self, i: usize, j: usize) {}

    // Puts the elements of a `&var [T]` in the opposite order.
    fn reverse(var self) {}

    // Moves every element of a `&var [T]` `n` places to the left, those that
    // fall off the start coming back at the end.
    fn rotate_left(var self, n: usize) {}

    // Moves every element of a `&var [T]` `n` places to the right, those
    // that fall off the end coming back at the start.
    fn rotate_right(var self, n: usize) {}
}

// An integer: i8, i16, i32, i64, isize, u8, u16, u32, u64 or usize. Its
// methods work on its bits.
//
// # Examples
//
// ```zeru
// var flags: u8 = 0b1011_0000;
// println("{} {}", flags.count_ones(), flags.rotate_left(2)); // 3 194
// ```
struct Int<T> {
    // Returns how many of its bits are 1.
    fn count_ones(self) usize {}

    // Returns how many 0 bits come before its highest 1 bit.
    fn leading_zeros(self) usize {}

    // Returns how many 0 bits come after its lowest 1 bit.
    fn trailing_zeros(self) usize {}

    // Returns it with its bits moved `n` places to the left, those that fall
    // off the top coming back at the bottom.
    fn rotate_left(self, n: usize) T {}

    // Returns it with its bits moved `n` places to the right, those that
    // fall off the bottom coming back at the top.
    fn rotate_right(self, n: usize) T {}

    // Returns it with its bytes in the opposite order.
    fn swap_bytes(self) T {}
}

// Text that owns its bytes, grows, and frees them when it goes out of scope.
//
// A string literal is a `str`; a String is text made at runtime, as
// `fs::read_file` gives or `push_str` builds. A String goes wherever a `str`
// does, so every `str` method works on it, as do `s[i]`, `for b in s`, `==`
// and printing. Like a `Vec`, assigning or passing it moves it.
//
// # Examples
//
// ```zeru
// var name = String.from("ze");
// name.push_str("ru");
// name[0] = 'Z';
// println("{} {} {}", name, name.len(), name == "Zeru"); // Zeru 4 true
// ```
pub struct String {
    // Returns an empty String; it allocates nothing until text is added.
    fn new() String {}

    // Returns a String holding a copy of `text`.
    //
    // # Examples
    //
    // ```zeru
    // var s = String.from("hi");
    // s.push('!');
    // println("{}", s); // hi!
    // ```
    fn from(text: str) String {}

    // Adds `text` at the end.
    //
    // # Examples
    //
    // ```zeru
    // var path = String.from("/home");
    // path.push_str("/zeru");
    // println("{}", path); // /home/zeru
    // ```
    fn push_str(var self, text: str) {}

    // Adds one byte at the end, as `'a'`.
    fn push(var self, byte: u8) {}

    // Removes all the text, keeping the memory for new text.
    fn clear(var self) {}

    // Returns an empty String with room for `capacity` bytes.
    fn with_capacity(capacity: usize) String {}

    // Returns how many bytes fit before it grows.
    fn capacity(self) usize {}

    // Makes room for `additional` more bytes.
    fn reserve(var self, additional: usize) {}

    // Gives back the memory it does not use.
    fn shrink_to_fit(var self) {}

    // Removes and returns the last byte, or None when empty.
    fn pop(var self) u8? {}

    // Puts `byte` at `index`, moving the rest one place on.
    fn insert(var self, index: usize, byte: u8) {}

    // Removes and returns the byte at `index`.
    fn remove(var self, index: usize) u8 {}

    // Returns the byte at `index`, or None past the end.
    fn get(self, index: usize) (&u8)? {}

    // Sorts the bytes from smallest to largest.
    fn sort(var self) {}

    // Exchanges the bytes at `i` and `j`.
    fn swap(var self, i: usize, j: usize) {}

    // Puts the bytes in the opposite order.
    fn reverse(var self) {}

    // Moves every byte `n` places to the left; those that fall off the start
    // come back at the end.
    fn rotate_left(var self, n: usize) {}

    // Moves every byte `n` places to the right; those that fall off the end
    // come back at the start.
    fn rotate_right(var self, n: usize) {}

    // Removes each byte equal to the one before it.
    fn dedup(var self) {}

    // Returns views of the bytes `n` at a time, the last one shorter when
    // they do not divide evenly.
    fn chunks(self, n: usize) Vec<&[u8]> {}

    // Returns a view of every run of `n` bytes next to each other.
    fn windows(self, n: usize) Vec<&[u8]> {}

    // Returns the bytes added up, or 0 when there are none.
    fn sum(self) u8 {}

    // Returns the smallest byte, or None when there are none.
    fn min(self) u8? {}

    // Returns the largest byte, or None when there are none.
    fn max(self) u8? {}

    // Returns the length in bytes.
    fn len(self) usize {}

    // Returns whether it holds no text.
    fn is_empty(self) bool {}

    // A second String holding a copy of the text.
    fn copy(self) String {}

    // The parts between each `sep`, or the words with no `sep`, as
    // `str.split` gives them.
    fn split(self, sep: str) Vec<str> {}

    // The lines, as `str.lines` gives them.
    fn lines(self) Vec<str> {}

    // The text without spaces, tabs and line breaks at either end.
    fn trim(self) str {}

    // Returns whether it begins with `prefix`.
    fn starts_with(self, prefix: str) bool {}

    // Returns whether it ends with `suffix`.
    fn ends_with(self, suffix: str) bool {}

    // Returns whether `t` appears in it.
    fn contains(self, t: str) bool {}

    // The byte where `t` first starts, as `str.find` gives it.
    fn find(self, t: str) usize? {}

    // The integer it spells, as `str.parse_int` reads it.
    fn parse_int(self) i64! {}

    // The number it spells, as `str.parse_float` reads it.
    fn parse_float(self) f64! {}
}

// Text, as a read-only slice of bytes.
//
// A string literal, `"..."` with escapes or `` `...` `` taken as written,
// is a `str`. Text is UTF-8, so a character outside ASCII takes several
// bytes: `"é"` takes 2. `s[i]` reads the byte at `i`, `for b in s` walks
// the bytes, and `==` compares the bytes.
//
// # Examples
//
// ```zeru
// var s = "zeru";
// println("{} {} {}", s.len(), s[0] == 'z', s == "zeru"); // 4 true true
// println("{}", "é".len()); // 2
// ```
struct Str {
    // Returns the length in bytes.
    fn len(self) usize {}

    // Returns the parts of the text between each `sep`, or with no `sep`
    // the words between spaces, tabs and line breaks.
    //
    // The parts share the memory of the text, nothing is copied. With a
    // `sep`, two in a row give an empty part between them, and an empty
    // `sep` gives the whole text as the only part. Without one, runs of
    // blanks count as one and no part is empty.
    //
    // # Examples
    //
    // ```zeru
    // var parts = "a,b,,c".split(",");
    // println("{} {} {}", parts.len(), parts[1], parts[2].len()); // 4 b 0
    // println("{}", "  84283   63343\n".split()); // ["84283", "63343"]
    // ```
    fn split(self, sep: str) Vec<str> {}

    // Returns the lines of the text, without their `"\n"` or `"\r\n"`.
    //
    // A final `"\n"` adds no empty line at the end.
    //
    // # Examples
    //
    // ```zeru
    // var lines = "first\r\nsecond\n".lines();
    // println("{} {}", lines.len(), lines[1]); // 2 second
    // ```
    fn lines(self) Vec<str> {}

    // Returns the text without the spaces, tabs and line breaks at either
    // end.
    //
    // # Examples
    //
    // ```zeru
    // println("[{}]", "  hi there \n".trim()); // [hi there]
    // ```
    fn trim(self) str {}

    // Returns whether the text begins with `prefix`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "zeru build".starts_with("zeru")); // true
    // ```
    fn starts_with(self, prefix: str) bool {}

    // Returns whether the text ends with `suffix`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "main.zr".ends_with(".zr")); // true
    // ```
    fn ends_with(self, suffix: str) bool {}

    // Returns whether `t` appears in the text.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "zeru build".contains("ru b")); // true
    // ```
    fn contains(self, t: str) bool {}

    // Returns the byte where `t` first starts, or `None` when it is absent.
    //
    // # Examples
    //
    // ```zeru
    // var line = "name: Zeru";
    // println("{}", line[line.find(":").unwrap() + 2..]); // Zeru
    // ```
    fn find(self, t: str) usize? {}

    // Returns the integer the text spells, as `"42"`, `"-7"` or `"+3"`.
    //
    // The whole text must be digits after an optional sign, with no spaces;
    // `trim` removes those first.
    //
    // # Errors
    //
    // 22 (EINVAL) when the text is not an integer, 34 (ERANGE) when it
    // does not fit an `i64`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "-42".parse_int().unwrap()); // -42
    // println("{}", "4x".parse_int().unwrap_err()); // 22
    // println("{}", "99999999999999999999".parse_int().unwrap_err()); // 34
    // ```
    fn parse_int(self) i64! {}

    // Returns the number the text spells, as `"3.5"`, `"-2"` or `"1e-3"`.
    //
    // Rounded to the nearest f64, so a number printed and read back gives
    // the same value.
    //
    // # Errors
    //
    // 22 (EINVAL) when the text is not a number.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "3.25".parse_float().unwrap()); // 3.25
    // println("{}", "1e-3".parse_float().unwrap()); // 0.001
    // println("{}", "pi".parse_float().unwrap_err()); // 22
    // ```
    fn parse_float(self) f64! {}
}

// `T?`: a value of type `T`, or None.
//
// A function returning `T?` gives a `T` with `return value;` and nothing
// with `return None;`. `match` takes both cases apart, and `x?` inside such
// a function returns None at once when `x` is None.
//
// # Examples
//
// ```zeru
// fn first_even(v: Vec<i32>) i32? {
//     for x in v {
//         if x % 2 == 0 {
//             return x;
//         }
//     }
//     return None;
// }
//
// fn main() {
//     match first_even(Vec[3, 8, 5]) {
//         Some(x) => println("{}", x), // 8
//         None => println("none"),
//     }
//     println("{}", first_even(Vec[1]).is_none()); // true
// }
// ```
struct Optional<T, U> {
    // Returns whether it holds a value.
    fn is_some(self) bool {}

    // Returns whether it is None.
    fn is_none(self) bool {}

    // Returns the value inside.
    //
    // # Panics
    //
    // When it is None.
    fn unwrap(self) T {}

    // Returns a copy of the value it holds, read through the reference when
    // it holds one.
    fn copy(self) U? {}
}

// `T!`: a value of type `T`, or an `i32` error code.
//
// A function returning `T!` gives a value with `return value;` and an error
// with `return Err(code);`. `match` takes both cases apart, and `x!`
// inside such a function returns the error at once when `x` holds one.
//
// # Examples
//
// ```zeru
// fn half(n: i32) i32! {
//     if n % 2 != 0 {
//         return Err(22);
//     }
//     return n / 2;
// }
//
// fn quarter(n: i32) i32! {
//     return half(half(n)!);
// }
//
// fn main() {
//     println("{}", quarter(12).unwrap()); // 3
//     match quarter(6) {
//         Ok(n) => println("{}", n),
//         Err(code) => println("error {}", code), // error 22
//     }
// }
// ```
struct Result<T> {
    // Returns whether it holds a value.
    fn is_ok(self) bool {}

    // Returns whether it holds an error code.
    fn is_err(self) bool {}

    // Returns the value inside.
    //
    // # Panics
    //
    // When it holds an error code.
    fn unwrap(self) T {}

    // Returns the error code inside.
    //
    // # Panics
    //
    // When it holds a value.
    fn unwrap_err(self) i32 {}
}

// Writes `format` to stdout, each `{}` replaced by the next value.
//
// Values are numbers, bools, text, and lists, tuples, optionals and
// results of them: `[1, 2]`, `(1, "a")`, `None`, `Err(2)`, with text inside
// them quoted. `{{}}` writes `{}` itself. The output waits in a buffer that
// `println` and the end of the program flush.
//
// `{:spec}` writes a number, bool or text padded to a width, `<`, `>` or
// `^` placing it with a fill character before that, `0` padding a number
// with zeros; `.n` gives a float `n` decimals, and `x`, `X`, `o` or `b`
// an integer in hexadecimal, octal or binary.
//
// # Examples
//
// ```zeru
// print("{} + {} = ", 2, 3);
// println("{}", 5); // 2 + 3 = 5
// var v: Vec<str> = Vec["a", "b"];
// println("{} {}", v, (1, true)); // ["a", "b"] (1, true)
// println("[{:>5}] [{:.2}] [{:08b}] [{:*^5}]", 42, 3.14159, 5, "x"); // [   42] [3.14] [00000101] [**x**]
// ```
pub fn print(format: str) {}

// Writes `format` to stdout as `print` does, then a line break, and
// flushes.
//
// # Examples
//
// ```zeru
// println("{} is {} years old", "Ann", 30); // Ann is 30 years old
// println("{{}} stays"); // {} stays
// ```
pub fn println(format: str) {}

// Puts `value` in the place `place` refers to and returns what was there,
// which takes a value out of a field, an element or a variable without a
// copy.
//
// # Examples
//
// ```zeru
// var names: Vec<String> = Vec[String.from("ann")];
// var taken = replace(&var names[0], String.from("bob"));
// println("{} {}", taken, names); // ann ["bob"]
// ```
pub fn replace<T>(place: &var T, value: T) T {}

// Writes `format` to stderr as `print` does.
pub fn eprint(format: str) {}

// Writes `format` to stderr as `println` does, for errors and diagnostics.
pub fn eprintln(format: str) {}

// Stops the program when `cond` is false, writing where to stderr and
// then the message after `cond`, formatted as `print` does, or `cond` as
// written.
//
// `--release-fast` builds leave every `assert` out, `cond` included.
//
// # Examples
//
// ```zeru
// var v: Vec<i32> = Vec[1, 2];
// assert(v.len() == 2);
// assert(v[0] < v[1], "{} comes first", v[0]);
// println("sorted"); // sorted
// ```
pub fn assert(cond: bool) {}
