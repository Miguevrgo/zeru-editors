// A list of values of one type that grows on the heap.
//
// A Vec owns its elements: assigning or passing it moves it, and `copy`
// makes a second one. `v[i]` reads or writes an element and panics past
// the end; `for x in v` walks the elements and `for i, x in v` their
// indexes too.
//
// # Examples
//
// ```zeru
// var v: Vec<i32> = [3, 1, 2];
// v.push(5);
// v[0] = 4;
// for i, x in v {
//     print("{}:{} ", i, x);
// }
// println(""); // 0:4 1:1 2:2 3:5
// ```
pub struct Vec<T> {
    // Returns an empty Vec.
    //
    // It allocates nothing until the first push. A list literal makes one
    // with elements: `var v: Vec<i32> = [1, 2, 3];`.
    //
    // # Examples
    //
    // ```zeru
    // var names: Vec<str> = Vec.new();
    // println("{}", names.len()); // 0
    // ```
    fn new() Vec<T> {}

    // Returns an empty Vec with room for `capacity` elements.
    //
    // Pushing up to `capacity` elements then allocates nothing more, which
    // saves time when the final size is known.
    //
    // # Examples
    //
    // ```zeru
    // var squares: Vec<i32> = Vec.with_capacity(10);
    // for i in 0..10 {
    //     squares.push(i * i);
    // }
    // println("{} {}", squares.len(), squares.capacity()); // 10 10
    // ```
    fn with_capacity(capacity: usize) Vec<T> {}

    // Returns the number of elements.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<str> = ["a", "b"];
    // println("{}", v.len()); // 2
    // ```
    fn len(self) usize {}

    // Returns how many elements fit before the Vec has to grow.
    //
    // It is never less than the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.with_capacity(8);
    // v.push(1);
    // println("{} {}", v.len(), v.capacity()); // 1 8
    // ```
    fn capacity(self) usize {}

    // Returns whether the Vec has no elements.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.new();
    // println("{}", v.is_empty()); // true
    // v.push(1);
    // println("{}", v.is_empty()); // false
    // ```
    fn is_empty(self) bool {}

    // Adds `value` at the end.
    //
    // When the Vec is full it moves to a buffer twice as big, so pushing
    // takes O(1) time on average.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [1, 2];
    // v.push(3);
    // println("{} {}", v.len(), v[2]); // 3 3
    // ```
    fn push(var self, value: T) {}

    // Removes the last element and returns it, or None when the Vec is empty.
    //
    // # Examples
    //
    // ```zeru
    // var stack: Vec<i32> = [1, 2];
    // println("{}", stack.pop().unwrap()); // 2
    // println("{}", stack.pop().unwrap()); // 1
    // println("{}", stack.pop().is_none()); // true
    // ```
    fn pop(var self) T? {}

    // Inserts `value` at `index`, moving the elements after it one place up.
    //
    // Takes O(n) time; `push` adds at the end in O(1). An `index` equal to
    // the length adds at the end.
    //
    // # Panics
    //
    // When `index` is greater than the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [1, 3];
    // v.insert(1, 2);
    // println("{} {} {}", v[0], v[1], v[2]); // 1 2 3
    // ```
    fn insert(var self, index: usize, value: T) {}

    // Removes the element at `index` and returns it, moving the elements
    // after it one place down.
    //
    // Takes O(n) time; `pop` removes the last element in O(1).
    //
    // # Panics
    //
    // When `index` is past the end.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [10, 20, 30];
    // println("{}", v.remove(0)); // 10
    // println("{} {}", v.len(), v[0]); // 2 20
    // ```
    fn remove(var self, index: usize) T {}

    // Returns a reference to the element at `index`, or None past the end.
    //
    // Unlike `v[index]` it does not panic. `*` reads the element through
    // the reference; `.copy()` on the result gives a `T?` holding a copy.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [7, 8];
    // println("{}", *v.get(1).unwrap()); // 8
    // println("{}", v.get(2).is_none()); // true
    // ```
    fn get(self, index: usize) (&T)? {}

    // Removes every element, keeping the memory for new ones.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [1, 2, 3];
    // v.clear();
    // println("{} {}", v.is_empty(), v.capacity() >= 3); // true true
    // ```
    fn clear(var self) {}

    // Makes room for at least `additional` more elements, so pushing them
    // allocates nothing more.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [1];
    // v.reserve(100);
    // println("{}", v.capacity() >= 101); // true
    // ```
    fn reserve(var self, additional: usize) {}

    // Gives back the memory not in use, so the capacity equals the length.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = Vec.with_capacity(100);
    // v.push(1);
    // v.shrink_to_fit();
    // println("{}", v.capacity()); // 1
    // ```
    fn shrink_to_fit(var self) {}

    // Returns a second Vec holding a copy of every element.
    //
    // Takes O(n) time. Use it when both Vecs must stay usable, since
    // assigning a Vec moves it.
    //
    // # Examples
    //
    // ```zeru
    // var a: Vec<i32> = [1, 2];
    // var b = a.copy();
    // b.push(3);
    // println("{} {}", a.len(), b.len()); // 2 3
    // ```
    fn copy(self) Vec<T> {}

    // Sorts the elements from smallest to largest.
    //
    // For numbers. Takes O(n log n) time and no extra memory; equal
    // elements may change order.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [5, -1, 3];
    // v.sort();
    // println("{} {} {}", v[0], v[1], v[2]); // -1 3 5
    // ```
    fn sort(var self) {}

    // Exchanges the elements at `i` and `j`.
    //
    // # Panics
    //
    // When `i` or `j` is past the end.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<str> = ["a", "b", "c"];
    // v.swap(0, 2);
    // println("{} {}", v[0], v[2]); // c a
    // ```
    fn swap(var self, i: usize, j: usize) {}

    // Puts the elements in the opposite order.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [1, 2, 3];
    // v.reverse();
    // println("{}", v); // [3, 2, 1]
    // ```
    fn reverse(var self) {}

    // Returns whether an element equals `value`.
    //
    // Takes O(n) time, looking at each element in turn.
    //
    // # Examples
    //
    // ```zeru
    // var primes: Vec<i32> = [2, 3, 5, 7];
    // println("{} {}", primes.contains(5), primes.contains(4)); // true false
    // ```
    fn contains(self, value: T) bool {}

    // Returns the elements added up, or 0 when there are none.
    //
    // For numbers.
    //
    // # Panics
    //
    // When an integer total does not fit its type.
    //
    // # Examples
    //
    // ```zeru
    // var prices: Vec<f64> = [1.5, 2.25];
    // println("{}", prices.sum()); // 3.75
    // ```
    fn sum(self) T {}

    // Returns the smallest element, or None when there are none.
    //
    // For numbers.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [4, -2, 9];
    // println("{}", v.min().unwrap()); // -2
    // ```
    fn min(self) T? {}

    // Returns the largest element, or None when there are none.
    //
    // For numbers.
    //
    // # Examples
    //
    // ```zeru
    // var v: Vec<i32> = [4, -2, 9];
    // println("{}", v.max().unwrap()); // 9
    // ```
    fn max(self) T? {}
}

// Text that owns its bytes, grows, and frees them when it goes out of scope.
//
// A string literal is a `str`; a String is text made at runtime, as
// `fs::read_file` gives or `push_str` builds. A String goes wherever a `str`
// does, so every `str` method works on it, as do `s[i]`, `for b in s`, `==`
// and printing. Like a `Vec`, assigning or passing it moves it.
//
// # Examples
//
// ```zeru
// var name = String.from("ze");
// name.push_str("ru");
// name[0] = 'Z';
// println("{} {} {}", name, name.len(), name == "Zeru"); // Zeru 4 true
// ```
pub struct String {
    // Returns an empty String; it allocates nothing until text is added.
    fn new() String {}

    // Returns a String holding a copy of `text`.
    //
    // # Examples
    //
    // ```zeru
    // var s = String.from("hi");
    // s.push('!');
    // println("{}", s); // hi!
    // ```
    fn from(text: str) String {}

    // Adds `text` at the end.
    //
    // # Examples
    //
    // ```zeru
    // var path = String.from("/home");
    // path.push_str("/zeru");
    // println("{}", path); // /home/zeru
    // ```
    fn push_str(var self, text: str) {}

    // Adds one byte at the end, as `'a'`.
    fn push(var self, byte: u8) {}

    // Removes all the text, keeping the memory for new text.
    fn clear(var self) {}

    // Returns the length in bytes.
    fn len(self) usize {}

    // Returns whether it holds no text.
    fn is_empty(self) bool {}

    // A second String holding a copy of the text.
    fn copy(self) String {}

    // The parts between each `sep`, or the words with no `sep`, as
    // `str.split` gives them.
    fn split(self, sep: str) Vec<str> {}

    // The lines, as `str.lines` gives them.
    fn lines(self) Vec<str> {}

    // The text without spaces, tabs and line breaks at either end.
    fn trim(self) str {}

    // Returns whether it begins with `prefix`.
    fn starts_with(self, prefix: str) bool {}

    // Returns whether it ends with `suffix`.
    fn ends_with(self, suffix: str) bool {}

    // The integer it spells, as `str.parse_int` reads it.
    fn parse_int(self) i64! {}

    // The number it spells, as `str.parse_float` reads it.
    fn parse_float(self) f64! {}
}

// Text, as a read-only slice of bytes.
//
// A string literal, `"..."` with escapes or `` `...` `` taken as written,
// is a `str`. Text is UTF-8, so a character outside ASCII takes several
// bytes: `"é"` takes 2. `s[i]` reads the byte at `i`, `for b in s` walks
// the bytes, and `==` compares the bytes.
//
// # Examples
//
// ```zeru
// var s = "zeru";
// println("{} {} {}", s.len(), s[0] == 'z', s == "zeru"); // 4 true true
// println("{}", "é".len()); // 2
// ```
struct Str {
    // Returns the length in bytes.
    fn len(self) usize {}

    // Returns the parts of the text between each `sep`, or with no `sep`
    // the words between spaces, tabs and line breaks.
    //
    // The parts share the memory of the text, nothing is copied. With a
    // `sep`, two in a row give an empty part between them, and an empty
    // `sep` gives the whole text as the only part. Without one, runs of
    // blanks count as one and no part is empty.
    //
    // # Examples
    //
    // ```zeru
    // var parts = "a,b,,c".split(",");
    // println("{} {} {}", parts.len(), parts[1], parts[2].len()); // 4 b 0
    // println("{}", "  84283   63343\n".split()); // ["84283", "63343"]
    // ```
    fn split(self, sep: str) Vec<str> {}

    // Returns the lines of the text, without their `"\n"` or `"\r\n"`.
    //
    // A final `"\n"` adds no empty line at the end.
    //
    // # Examples
    //
    // ```zeru
    // var lines = "first\r\nsecond\n".lines();
    // println("{} {}", lines.len(), lines[1]); // 2 second
    // ```
    fn lines(self) Vec<str> {}

    // Returns the text without the spaces, tabs and line breaks at either
    // end.
    //
    // # Examples
    //
    // ```zeru
    // println("[{}]", "  hi there \n".trim()); // [hi there]
    // ```
    fn trim(self) str {}

    // Returns whether the text begins with `prefix`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "zeru build".starts_with("zeru")); // true
    // ```
    fn starts_with(self, prefix: str) bool {}

    // Returns whether the text ends with `suffix`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "main.zr".ends_with(".zr")); // true
    // ```
    fn ends_with(self, suffix: str) bool {}

    // Returns the integer the text spells, as `"42"`, `"-7"` or `"+3"`.
    //
    // The whole text must be digits after an optional sign, with no spaces;
    // `trim` removes those first.
    //
    // # Errors
    //
    // 22 (EINVAL) when the text is not an integer, 34 (ERANGE) when it
    // does not fit an `i64`.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "-42".parse_int().unwrap()); // -42
    // println("{}", "4x".parse_int().unwrap_err()); // 22
    // println("{}", "99999999999999999999".parse_int().unwrap_err()); // 34
    // ```
    fn parse_int(self) i64! {}

    // Returns the number the text spells, as `"3.5"`, `"-2"` or `"1e-3"`.
    //
    // Rounded to the nearest f64, so a number printed and read back gives
    // the same value.
    //
    // # Errors
    //
    // 22 (EINVAL) when the text is not a number.
    //
    // # Examples
    //
    // ```zeru
    // println("{}", "3.25".parse_float().unwrap()); // 3.25
    // println("{}", "1e-3".parse_float().unwrap()); // 0.001
    // println("{}", "pi".parse_float().unwrap_err()); // 22
    // ```
    fn parse_float(self) f64! {}
}

// `T?`: a value of type `T`, or None.
//
// A function returning `T?` gives a `T` with `return value;` and nothing
// with `return None;`. `match` takes both cases apart, and `x?` inside such
// a function returns None at once when `x` is None.
//
// # Examples
//
// ```zeru
// fn first_even(v: Vec<i32>) i32? {
//     for x in v {
//         if x % 2 == 0 {
//             return x;
//         }
//     }
//     return None;
// }
//
// fn main() {
//     match first_even([3, 8, 5]) {
//         Some(x) => println("{}", x), // 8
//         None => println("none"),
//     }
//     println("{}", first_even([1]).is_none()); // true
// }
// ```
struct Optional<T> {
    // Returns whether it holds a value.
    fn is_some(self) bool {}

    // Returns whether it is None.
    fn is_none(self) bool {}

    // Returns the value inside.
    //
    // # Panics
    //
    // When it is None.
    fn unwrap(self) T {}
}

// `T!`: a value of type `T`, or an `i32` error code.
//
// A function returning `T!` gives a value with `return value;` and an error
// with `return Err(code);`. `match` takes both cases apart, and `x!`
// inside such a function returns the error at once when `x` holds one.
//
// # Examples
//
// ```zeru
// fn half(n: i32) i32! {
//     if n % 2 != 0 {
//         return Err(22);
//     }
//     return n / 2;
// }
//
// fn quarter(n: i32) i32! {
//     return half(half(n)!);
// }
//
// fn main() {
//     println("{}", quarter(12).unwrap()); // 3
//     match quarter(6) {
//         Ok(n) => println("{}", n),
//         Err(code) => println("error {}", code), // error 22
//     }
// }
// ```
struct Result<T> {
    // Returns whether it holds a value.
    fn is_ok(self) bool {}

    // Returns whether it holds an error code.
    fn is_err(self) bool {}

    // Returns the value inside.
    //
    // # Panics
    //
    // When it holds an error code.
    fn unwrap(self) T {}

    // Returns the error code inside.
    //
    // # Panics
    //
    // When it holds a value.
    fn unwrap_err(self) i32 {}
}

// Writes `format` to stdout, each `{}` replaced by the next value.
//
// Values are numbers, bools, text, and lists, tuples, optionals and
// results of them: `[1, 2]`, `(1, "a")`, `None`, `Err(2)`, with text inside
// them quoted. `{{}}` writes `{}` itself. The output waits in a buffer that
// `println` and the end of the program flush.
//
// # Examples
//
// ```zeru
// print("{} + {} = ", 2, 3);
// println("{}", 5); // 2 + 3 = 5
// var v: Vec<str> = ["a", "b"];
// println("{} {}", v, (1, true)); // ["a", "b"] (1, true)
// ```
pub fn print(format: str) {}

// Writes `format` to stdout as `print` does, then a line break, and
// flushes.
//
// # Examples
//
// ```zeru
// println("{} is {} years old", "Ann", 30); // Ann is 30 years old
// println("{{}} stays"); // {} stays
// ```
pub fn println(format: str) {}

// Writes `format` to stderr as `print` does.
pub fn eprint(format: str) {}

// Writes `format` to stderr as `println` does, for errors and diagnostics.
pub fn eprintln(format: str) {}

// Stops the program when `cond` is false, writing where to stderr and
// then the message after `cond`, formatted as `print` does, or `cond` as
// written.
//
// `--release-fast` builds leave every `assert` out, `cond` included.
//
// # Examples
//
// ```zeru
// var v: Vec<i32> = [1, 2];
// assert(v.len() == 2);
// assert(v[0] < v[1], "{} comes first", v[0]);
// println("sorted"); // sorted
// ```
pub fn assert(cond: bool) {}
