{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Zeru",
    "scopeName": "source.zeru",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.zeru",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.zeru",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.zeru",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zeru",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.other.zeru",
                    "begin": "`",
                    "end": "`"
                }
            ]
        },
        "characters": {
            "patterns": [
                {
                    "name": "constant.character.zeru",
                    "match": "'(\\\\.|[^'\\\\])'"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zeru",
                    "match": "\\b(if|else|while|for|in|break|continue|return|match|default)\\b"
                },
                {
                    "name": "keyword.declaration.zeru",
                    "match": "\\b(fn|var|const|pub|struct|enum|trait|import|as|asm|volatile)\\b"
                },
                {
                    "name": "constant.language.zeru",
                    "match": "\\b(true|false|None|Some|Ok|Err)\\b"
                },
                {
                    "name": "variable.language.self.zeru",
                    "match": "\\bself\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.zeru",
                    "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|void|str)\\b"
                },
                {
                    "name": "entity.name.type.zeru",
                    "match": "\\b[A-Z][a-z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.zeru",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.zeru",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.octal.zeru",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.float.zeru",
                    "match": "\\b\\d[0-9_]*(\\.\\d[0-9_]*)?([eE][+-]?\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.zeru",
                    "match": "([-+*/%&|^<>!=]=*|&&|\\|\\||=>|::|\\.\\.)"
                }
            ]
        }
    }
}
